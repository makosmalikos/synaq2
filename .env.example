# Copy to .env in the repository root. Never commit actual credentials.
# Landing-form global abuse ceiling (in addition to 5/IP and 3/contact/hour).
LEAD_GLOBAL_HOURLY_LIMIT=100
PORT=4000
APP_URL=http://localhost:5173
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EXPLAIN_FREE_DAILY_LIMIT=5
EXPLAIN_STANDARD_DAILY_LIMIT=15
EXPLAIN_PRO_DAILY_LIMIT=40
EXPLAIN_FREE_DAILY_INPUT_BYTES=131072
EXPLAIN_STANDARD_DAILY_INPUT_BYTES=262144
EXPLAIN_PRO_DAILY_INPUT_BYTES=524288
EXPLAIN_GLOBAL_DAILY_LIMIT=1000
EXPLAIN_GLOBAL_DAILY_INPUT_BYTES=20971520
ADMIN_EMAIL_1=
ADMIN_EMAIL_2=
# New payments use shared/payments.json (Kaspi), without API keys.
# Keep the following only while servicing pre-existing Dodo subscriptions.
DODO_ENV=test_mode
DODO_PAYMENTS_API_KEY=
DODO_STANDARD_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
# Legacy weekly product, only for previously initiated Dodo payments:
DODO_WEEKLY_MOCK_PRODUCT_ID=
# Backward-compatible alias for DODO_PRO_PRODUCT_ID:
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
