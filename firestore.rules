rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist (лендинг): любой может записаться, читать нельзя
    match /waitlist/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if false;
    }

    // Семья: доступ только у самого родителя (владельца)
    match /families/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /children/{childUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Индекс ребёнка: ребёнок читает свой; родитель меняет только индекс своего ребёнка
    match /childIndex/{childUid} {
      allow read: if request.auth != null && request.auth.uid == childUid;
      allow create, update: if request.auth != null
                            && request.resource.data.parentUid == request.auth.uid
                            && exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childUid));
      allow delete: if request.auth != null
                    && resource.data.parentUid == request.auth.uid;
    }

    // Результаты: ребёнок пишет/читает свои; родитель читает результаты своих детей
    match /results/{childUid}/{document=**} {
      allow write: if request.auth != null && request.auth.uid == childUid;
      allow read: if request.auth != null && (
        request.auth.uid == childUid ||
        exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childUid))
      );
    }

    // Кэш AI-разборов (Gemini): читать всем залогиненным, писать один раз
    match /explanations/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Дуэли в реальном времени
    match /duels/{duelId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.host.uid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.host.uid == request.auth.uid ||
        (resource.data.guest != null && resource.data.guest.uid == request.auth.uid) ||
        // Первый вход гостя: можно сразу перевести комнату в playing
        (resource.data.guest == null
          && request.resource.data.guest.uid == request.auth.uid
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'playing')
      );
      allow delete: if false;
    }
  }
}
