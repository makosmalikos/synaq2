rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Waitlist (лендинг): любой может записаться, читать нельзя
    match /waitlist/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if false;
    }

    // Семья: доступ только у самого родителя (владельца)
    match /families/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /children/{childUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Индекс ребёнка: ребёнок читает свой; родитель создаёт
    match /childIndex/{childUid} {
      allow read: if request.auth != null && request.auth.uid == childUid;
      allow write: if request.auth != null;
    }

    // Результаты: ребёнок пишет/читает свои; родитель читает результаты своих детей
    match /results/{childUid}/{document=**} {
      allow write: if request.auth != null && request.auth.uid == childUid;
      allow read: if request.auth != null && (
        request.auth.uid == childUid ||
        exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childUid))
      );
    }
  }
}
