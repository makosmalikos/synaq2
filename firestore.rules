rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParentOf(childUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/childIndex/$(childUid))
        && get(/databases/$(database)/documents/childIndex/$(childUid)).data.parentUid == request.auth.uid;
    }

    function isDuelPlayer(data) {
      return isSignedIn() && (
        data.host.uid == request.auth.uid
        || (data.guest != null && data.guest.uid == request.auth.uid)
      );
    }

    function validDuelNumbers(data) {
      return data.qIndex is int
        && data.qIndex >= 0
        && data.qIndex < data.questions.size()
        && data.scores.host is int
        && data.scores.guest is int
        && data.scores.host >= 0
        && data.scores.guest >= 0
        && data.scores.host <= data.questions.size()
        && data.scores.guest <= data.questions.size()
        && data.speedWins.host is int
        && data.speedWins.guest is int
        && data.speedWins.host >= 0
        && data.speedWins.guest >= 0
        && data.speedWins.host <= data.questions.size()
        && data.speedWins.guest <= data.questions.size();
    }

    function validPlayerScoreChange(before, after) {
      return after.scores.host >= before.scores.host
        && after.scores.guest >= before.scores.guest
        && after.scores.host <= before.scores.host + 1
        && after.scores.guest <= before.scores.guest + 1
        && (before.host.uid == request.auth.uid
          ? after.scores.guest == before.scores.guest
          : after.scores.host == before.scores.host)
        && after.speedWins.host >= before.speedWins.host
        && after.speedWins.guest >= before.speedWins.guest
        && after.speedWins.host <= before.speedWins.host + 1
        && after.speedWins.guest <= before.speedWins.guest + 1;
    }

    match /waitlist/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if false;
    }

    // Семья: родитель управляет профилем; поля подписки меняет только webhook.
    match /families/{uid} {
      // Ребёнок получает только boolean pro через /api/entitlement и не видит
      // email родителя или платёжные metadata из семейного документа.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['parentEmail', 'parentName', 'createdAt']);
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['parentEmail', 'parentName']);
      allow delete: if false;
      match /children/{childUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Индекс ребёнка: ребёнок читает свой; родитель меняет только индекс своего ребёнка
    match /childIndex/{childUid} {
      allow read: if request.auth != null && request.auth.uid == childUid;
      allow create: if request.auth != null
                    && request.resource.data.parentUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['parentUid', 'name', 'klass'])
                    && exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childUid));
      allow update: if request.auth != null
                    && resource.data.parentUid == request.auth.uid
                    && request.resource.data.parentUid == resource.data.parentUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'klass'])
                    && exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childUid));
      allow delete: if request.auth != null
                    && resource.data.parentUid == request.auth.uid;
    }

    // Результаты: ребёнок пишет/читает свои; родитель читает результаты своих детей
    match /results/{childUid}/{document=**} {
      allow read: if isSignedIn() && (
        request.auth.uid == childUid || isParentOf(childUid)
      );
    }

    match /results/{childUid}/attempts/{attemptId} {
      allow create: if isSignedIn()
        && request.auth.uid == childUid
        && request.resource.data.qid is string;
      allow update, delete: if false;
    }

    match /results/{childUid}/solved/{qid} {
      allow create, update: if isSignedIn()
        && request.auth.uid == childUid
        && request.resource.data.qid is string;
      allow delete: if false;
    }

    match /results/{childUid}/flags/{qid} {
      allow create, delete: if isSignedIn() && request.auth.uid == childUid;
      allow update: if false;
    }

    match /results/{childUid}/mocks/{mockId} {
      allow create: if isSignedIn() && request.auth.uid == childUid;
      allow update, delete: if false;
    }

    match /results/{childUid}/stats/{docId} {
      allow read: if isSignedIn() && (
        request.auth.uid == childUid || isParentOf(childUid)
      );
      allow create, update: if isSignedIn()
        && request.auth.uid == childUid
        && request.resource.data.xp is number
        && request.resource.data.studySecs is number
        && (!resource.exists()
          || (request.resource.data.xp >= resource.data.xp
            && request.resource.data.xp <= resource.data.xp + 120
            && request.resource.data.studySecs >= resource.data.studySecs
            && request.resource.data.studySecs <= resource.data.studySecs + 7200));
      allow delete: if false;
    }

    // Банк задач от администратора (Admin Panel). Читают все вошедшие — нужно
    // для Тренировки. Пишет только сервер через Firebase Admin SDK
    // (api/admin-task.js), который обходит эти правила, — поэтому write: false.
    match /bankTasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /explanations/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Общий кэш переводов условий задач (api.js: translateQuestions) — тот же
    // паттерн, что и explanations: перевели один раз, дальше отдаём всем бесплатно.
    match /translations/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Лимит AI-запросов на пользователя (счётчик пишет только сервер через Admin SDK — клиент не может)
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /duels/{duelId} {
      // Ожидающую комнату должен прочитать приглашённый ученик перед join.
      // После старта данные видят только два участника.
      allow read: if isSignedIn()
        && (resource.data.status == 'waiting' || isDuelPlayer(resource.data));
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'code', 'host', 'guest', 'status', 'questions', 'qIndex', 'scores',
          'speedWins', 'round', 'roundStartedAt', 'winner', 'createdAt'
        ])
        && request.resource.data.code == duelId
        && request.resource.data.host.uid == request.auth.uid
        && request.resource.data.guest == null
        && request.resource.data.status == 'waiting'
        && request.resource.data.questions is list
        && request.resource.data.questions.size() == 15
        && validDuelNumbers(request.resource.data);
      allow update: if isSignedIn() && (
        // Единственное изменение участников — свободное место занимает
        // авторизованный гость, после чего UID обоих игроков неизменяемы.
        (resource.data.guest == null
          && request.resource.data.guest.uid == request.auth.uid
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'playing'
          && request.resource.data.code == resource.data.code
          && request.resource.data.host == resource.data.host
          && request.resource.data.questions == resource.data.questions
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'guest', 'status', 'roundStartedAt', 'startedAt'
          ])
          && validDuelNumbers(request.resource.data))
        ||
        (isDuelPlayer(resource.data)
          && resource.data.status == 'playing'
          && (request.resource.data.status == 'playing' || request.resource.data.status == 'finished')
          && request.resource.data.code == resource.data.code
          && request.resource.data.host == resource.data.host
          && request.resource.data.guest == resource.data.guest
          && request.resource.data.questions == resource.data.questions
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.qIndex >= resource.data.qIndex
          && request.resource.data.qIndex <= resource.data.qIndex + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'qIndex', 'scores', 'speedWins', 'round', 'roundStartedAt',
            'status', 'winner', 'finishedAt'
          ])
          && validDuelNumbers(request.resource.data)
          && validPlayerScoreChange(resource.data, request.resource.data))
      );
      allow delete: if false;
    }
  }
}
