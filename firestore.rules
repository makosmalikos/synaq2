rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParentOf(childUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/childIndex/$(childUid))
        && get(/databases/$(database)/documents/childIndex/$(childUid)).data.parentUid == request.auth.uid;
    }

    function isChildLinkedToParent(parentUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/childIndex/$(request.auth.uid))
        && get(/databases/$(database)/documents/childIndex/$(request.auth.uid)).data.parentUid == parentUid;
    }

    function isDuelPlayer(data) {
      return isSignedIn() && (
        data.host.uid == request.auth.uid
        || (data.guest != null && data.guest.uid == request.auth.uid)
      );
    }

    match /waitlist/{doc} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update, delete: if false;
    }

    // Семья: родитель читает/пишет свой профиль, но НЕ поля подписки — их
    // выставляет только сервер (Admin SDK, api/webhook.js) при подтверждённой
    // оплате Dodo. Без этого ограничения родитель мог бы сам записать себе
    // pro:true прямо из консоли браузера, в обход оплаты.
    match /families/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isChildLinkedToParent(uid)
      );
      allow create: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['pro', 'dodoSubId', 'dodoStatus', 'proUpdatedAt']);
      allow update: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['pro', 'dodoSubId', 'dodoStatus', 'proUpdatedAt']);
      allow delete: if false;
      match /children/{childUid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Индекс ребёнка: ребёнок читает свой; родитель меняет только индекс своего
    // ребёнка. Поле pro родитель может писать ТОЛЬКО тем же значением, что уже
    // стоит в его families/{uid}.pro (так работает легитимная синхронизация —
    // createChild и Parent.jsx при входе), а не произвольным true — иначе это
    // была бы та же дыра, что и выше, только через другой документ.
    match /childIndex/{childUid} {
      allow read: if request.auth != null && request.auth.uid == childUid;
      allow create, update: if request.auth != null
                            && request.resource.data.parentUid == request.auth.uid
                            && exists(/databases/$(database)/documents/families/$(request.auth.uid)/children/$(childUid))
                            && exists(/databases/$(database)/documents/families/$(request.auth.uid))
                            && request.resource.data.pro ==
                                get(/databases/$(database)/documents/families/$(request.auth.uid)).data.get('pro', false);
      allow delete: if request.auth != null
                    && resource.data.parentUid == request.auth.uid;
    }

    // Результаты: ребёнок пишет/читает свои; родитель читает результаты своих детей
    match /results/{childUid}/{document=**} {
      allow read: if isSignedIn() && (
        request.auth.uid == childUid || isParentOf(childUid)
      );
    }

    match /results/{childUid}/attempts/{attemptId} {
      allow create: if isSignedIn()
        && request.auth.uid == childUid
        && request.resource.data.qid is string;
      allow update, delete: if false;
    }

    match /results/{childUid}/solved/{qid} {
      allow create, update: if isSignedIn()
        && request.auth.uid == childUid
        && request.resource.data.qid is string;
      allow delete: if false;
    }

    match /results/{childUid}/flags/{qid} {
      allow create, delete: if isSignedIn() && request.auth.uid == childUid;
      allow update: if false;
    }

    match /results/{childUid}/mocks/{mockId} {
      allow create: if isSignedIn() && request.auth.uid == childUid;
      allow update, delete: if false;
    }

    match /results/{childUid}/stats/{docId} {
      allow read: if isSignedIn() && (
        request.auth.uid == childUid || isParentOf(childUid)
      );
      allow create, update: if isSignedIn()
        && request.auth.uid == childUid
        && request.resource.data.xp is number
        && request.resource.data.studySecs is number
        && (!resource.exists()
          || (request.resource.data.xp >= resource.data.xp
            && request.resource.data.xp <= resource.data.xp + 120
            && request.resource.data.studySecs >= resource.data.studySecs
            && request.resource.data.studySecs <= resource.data.studySecs + 7200));
      allow delete: if false;
    }

    // Банк задач от администратора (Admin Panel). Читают все вошедшие — нужно
    // для Тренировки. Пишет только сервер через Firebase Admin SDK
    // (api/admin-task.js), который обходит эти правила, — поэтому write: false.
    match /bankTasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /explanations/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Общий кэш переводов условий задач (api.js: translateQuestions) — тот же
    // паттерн, что и explanations: перевели один раз, дальше отдаём всем бесплатно.
    match /translations/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Лимит AI-запросов на пользователя (счётчик пишет только сервер через Admin SDK — клиент не может)
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /duels/{duelId} {
      allow read: if isSignedIn() && isDuelPlayer(resource.data);
      allow create: if isSignedIn()
        && request.resource.data.host.uid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.host.uid == request.auth.uid
        || (resource.data.guest != null && resource.data.guest.uid == request.auth.uid)
        || (resource.data.guest == null
          && request.resource.data.guest.uid == request.auth.uid
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'playing')
      );
      allow delete: if false;
    }
  }
}
