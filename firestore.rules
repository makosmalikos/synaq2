rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isParentOf(childUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/childIndex/$(childUid))
        && get(/databases/$(database)/documents/childIndex/$(childUid)).data.parentUid == request.auth.uid;
    }

    function isChildLinkedToParent(parentUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/childIndex/$(request.auth.uid))
        && get(/databases/$(database)/documents/childIndex/$(request.auth.uid)).data.parentUid == parentUid;
    }

    function isDuelPlayer(data) {
      return isSignedIn() && (
        data.host.uid == request.auth.uid
        || (data.guest != null && data.guest.uid == request.auth.uid)
      );
    }

    // Not used by the app any more (landing leads go through /api/lead).
    // Anonymous writes only allowed junk to fill the database.
    match /waitlist/{doc} {
      allow read, write: if false;
    }

    // Семья: родитель читает/пишет свой профиль, но НЕ поля подписки — их
    // выставляет только сервер (Admin SDK, api/webhook.js) при подтверждённой
    // оплате Dodo. Без этого ограничения родитель мог бы сам записать себе
    // pro:true прямо из консоли браузера, в обход оплаты.
    match /families/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid || isChildLinkedToParent(uid)
      );
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['parentEmail', 'parentName', 'createdAt']);
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentEmail', 'parentName']);
      allow delete: if false;
      match /children/{childUid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        // Linking a new Auth account is an atomic Admin SDK operation.
        allow write: if false;
      }
    }

    // Server-owned relationship and mirrored entitlement. Neither parent nor
    // child may create/reassign an index from the browser.
    match /childIndex/{childUid} {
      allow read: if request.auth != null && request.auth.uid == childUid;
      allow write: if false;
    }

    // Results are readable by the child and their parent. Verified practice and
    // XP are written only by the learning API (Admin SDK).
    match /results/{childUid}/{document=**} {
      allow read: if isSignedIn() && (
        request.auth.uid == childUid || isParentOf(childUid)
      );
    }

    // Self-reported reading only. Verified mastery, attempts and XP remain
    // server-owned. Keep this allowlist aligned with the curriculum catalog.
    match /results/{childUid}/lessonReading/{lessonKey} {
      function knownLesson() {
        return lessonKey in [
          'g3-review-1', 'g3-review-2', 'g3-review-3', 'g3-multiplication-1',
          'g3-multiplication-2', 'g3-multiplication-3', 'g3-division-1', 'g3-division-2',
          'g3-division-3', 'g3-order-1', 'g3-order-2', 'g3-order-3',
          'g3-area-1', 'g3-area-2', 'g3-area-3', 'g3-perimeter-1',
          'g3-perimeter-2', 'g3-perimeter-3', 'g3-equation-1', 'g3-equation-2',
          'g3-equation-3', 'g3-to1000-1', 'g3-to1000-2', 'g3-to1000-3',
          'g3-written-1', 'g3-written-2', 'g3-written-3', 'g3-measures-1',
          'g3-measures-2', 'g3-measures-3', 'g3-money-1', 'g3-money-2',
          'g3-money-3', 'g3-mental-1', 'g3-mental-2', 'g3-mental-3',
          'g3-column-md-1', 'g3-column-md-2', 'g3-column-md-3', 'g3-word-1',
          'g3-word-2', 'g3-word-3', 'g4-big-1', 'g4-big-2',
          'g4-big-3', 'g4-round-1', 'g4-round-2', 'g4-round-3',
          'g4-addsub-1', 'g4-addsub-2', 'g4-addsub-3', 'g4-mul-1',
          'g4-mul-2', 'g4-mul-3', 'g4-mul-4', 'g4-division-1',
          'g4-division-2', 'g4-division-3', 'g4-division-4', 'g4-fractions-1',
          'g4-fractions-2', 'g4-fractions-3', 'g4-fraction-compare-1', 'g4-fraction-compare-2',
          'g4-fraction-compare-3', 'g4-geometry-1', 'g4-geometry-2', 'g4-geometry-3',
          'g4-motion-1', 'g4-motion-2', 'g4-motion-3', 'g4-time-1',
          'g4-time-2', 'g4-time-3', 'g4-equations-1', 'g4-equations-2',
          'g4-equations-3', 'g4-volume-1', 'g4-volume-2', 'g4-volume-3',
          'g4-combined-1', 'g4-combined-2', 'g4-combined-3', 'g5-natural-1',
          'g5-natural-2', 'g5-natural-3', 'g5-expressions-1', 'g5-expressions-2',
          'g5-expressions-3', 'g5-divisibility-1', 'g5-divisibility-2', 'g5-divisibility-3',
          'g5-gcd-1', 'g5-gcd-2', 'g5-gcd-3', 'g5-fraction-1',
          'g5-fraction-2', 'g5-fraction-3', 'g5-fraction-add-1', 'g5-fraction-add-2',
          'g5-fraction-add-3', 'g5-mixed-1', 'g5-mixed-2', 'g5-mixed-3',
          'g5-mixed-4', 'g5-decimals-1', 'g5-decimals-2', 'g5-decimals-3',
          'g5-decimal-ops-1', 'g5-decimal-ops-2', 'g5-decimal-ops-3', 'g5-decimal-ops-4',
          'g5-decimal-ops-5', 'g5-percent-1', 'g5-percent-2', 'g5-percent-3',
          'g5-angles-1', 'g5-angles-2', 'g5-angles-3', 'g5-data-1',
          'g5-data-2', 'g5-data-3', 'g5-motion-1', 'g5-motion-2',
          'g5-motion-3', 'g6-ratio-1', 'g6-ratio-2', 'g6-ratio-3',
          'g6-ratio-4', 'g6-proportion-1', 'g6-proportion-2', 'g6-proportion-3',
          'g6-scale-1', 'g6-scale-2', 'g6-scale-3', 'g6-percent-1',
          'g6-percent-2', 'g6-percent-3', 'g6-dependencies-1', 'g6-dependencies-2',
          'g6-dependencies-3', 'g6-integers-1', 'g6-integers-2', 'g6-integers-3',
          'g6-rational-ops-1', 'g6-rational-ops-2', 'g6-rational-ops-3', 'g6-expressions-1',
          'g6-expressions-2', 'g6-expressions-3', 'g6-linear-1', 'g6-linear-2',
          'g6-linear-3', 'g6-inequalities-1', 'g6-inequalities-2', 'g6-inequalities-3',
          'g6-coordinate-1', 'g6-coordinate-2', 'g6-coordinate-3', 'g6-geometry-1',
          'g6-geometry-2', 'g6-geometry-3', 'g6-systems-1', 'g6-systems-2',
          'g6-systems-3', 'g6-systems-4', 'g6-statistics-1', 'g6-statistics-2',
          'g6-statistics-3', 'g6-probability-1', 'g6-probability-2', 'g6-probability-3',
          'g6-combinatorics-1', 'g6-combinatorics-2', 'g6-combinatorics-3', 'g6-word-1',
          'g6-word-2', 'g6-word-3'
        ];
      }
      function validReading() {
        let data = request.resource.data;
        return knownLesson()
          && data.keys().hasAll(['lastStep', 'completedSteps', 'checkPassed', 'studiedAt', 'updatedAt'])
          && data.keys().hasOnly(['lastStep', 'completedSteps', 'checkPassed', 'studiedAt', 'updatedAt'])
          && data.lastStep in ['intro', 0, 1, 2, 3, 'check', 'summary']
          && data.completedSteps is list && data.completedSteps.size() <= 5
          && data.completedSteps.hasOnly(['intro', 0, 1, 2, 3])
          && data.completedSteps.toSet().size() == data.completedSteps.size()
          && data.checkPassed is bool
          && data.updatedAt is int && data.updatedAt > 0
          && data.updatedAt <= request.time.toMillis() + 300000
          && (data.studiedAt == null || (data.studiedAt is int && data.studiedAt > 0
            && data.studiedAt <= data.updatedAt && data.checkPassed
            && data.completedSteps.hasAll(['intro', 0, 1, 2, 3])));
      }
      allow create: if isSignedIn() && request.auth.uid == childUid && validReading();
      allow update: if isSignedIn() && request.auth.uid == childUid && validReading()
        && request.resource.data.completedSteps.hasAll(resource.data.completedSteps)
        && (!resource.data.checkPassed || request.resource.data.checkPassed)
        && (resource.data.studiedAt == null || request.resource.data.studiedAt != null);
      allow delete: if false;
    }

    match /results/{childUid}/attempts/{attemptId} {
      allow write: if false;
    }

    match /results/{childUid}/solved/{qid} {
      allow write: if false;
    }

    match /results/{childUid}/flags/{qid} {
      allow create: if isSignedIn() && request.auth.uid == childUid
        && exists(/databases/$(database)/documents/childIndex/$(childUid))
        && qid.matches('^[A-Za-z0-9_-]{1,200}$')
        && request.resource.data.keys().hasAll(['qid', 'at'])
        && request.resource.data.keys().hasOnly(['qid', 'at'])
        && request.resource.data.qid == qid
        && request.resource.data.at == request.time;
      allow delete: if isSignedIn() && request.auth.uid == childUid;
      allow update: if false;
    }

    match /results/{childUid}/mocks/{mockId} {
      allow write: if false;
    }

    // Полная диагностика проверяется и сохраняется только сервером.
    match /results/{childUid}/diagnostics/{diagnosticId} {
      allow write: if false;
    }

    match /results/{childUid}/stats/{docId} {
      allow read: if isSignedIn() && (
        request.auth.uid == childUid || isParentOf(childUid)
      );
      allow write: if false;
    }

    // Банк задач содержит правильные ответы, поэтому и чтение, и запись идут
    // только через серверные API с Firebase Admin SDK.
    match /bankTasks/{taskId} {
      allow read, write: if false;
    }

    match /explanations/{id} {
      allow read, write: if false;
    }

    // Общий кэш переводов условий задач (api.js: translateQuestions) — тот же
    // паттерн, что и explanations: перевели один раз, дальше отдаём всем бесплатно.
    match /translations/{id} {
      allow read, write: if false;
    }

    // Content-addressed AI cache, billing ledger and duel proofs are server-only.
    // Center workspaces are accessed through the role-scoped API. Students
    // may only observe their own server-owned seat and its public license.
    match /centers/{document=**} { allow read, write: if false; }
    match /centerStaff/{uid} { allow read, write: if false; }
    match /centerInvites/{id} { allow read, write: if false; }
    match /centerInviteRates/{id} { allow read, write: if false; }
    match /centerSeats/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /centerLicenses/{centerId} {
      allow read: if isSignedIn()
        && exists(/databases/$(database)/documents/centerSeats/$(request.auth.uid))
        && get(/databases/$(database)/documents/centerSeats/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/centerSeats/$(request.auth.uid)).data.centerId == centerId;
      allow write: if false;
    }

    match /bankTaskKeys/{id} { allow read, write: if false; }
    match /aiCache/{id} { allow read, write: if false; }
    match /paymentEvents/{id} { allow read, write: if false; }
    match /paymentSubscriptions/{id} { allow read, write: if false; }
    match /duelPrivate/{id} { allow read, write: if false; }
    match /duelRateLimits/{id} { allow read, write: if false; }
    match /rewardWallets/{id} { allow read, write: if false; }
    match /rewardRequests/{id} { allow read, write: if false; }
    match /learningSessions/{id} { allow read, write: if false; }
    match /learningRateLimits/{id} { allow read, write: if false; }
    match /mockSessions/{id} { allow read, write: if false; }
    match /mockRateLimits/{id} { allow read, write: if false; }
    match /mockDiagnosticClaims/{id} { allow read, write: if false; }
    match /diagnosticSessions/{id} { allow read, write: if false; }
    match /diagnosticRateLimits/{id} { allow read, write: if false; }
    match /platformRateLimits/{id} { allow read, write: if false; }
    match /checkoutSessions/{id} { allow read, write: if false; }
    match /weeklyMockCheckoutSessions/{id} { allow read, write: if false; }
    match /weeklyMockPasses/{id} { allow read, write: if false; }
    match /results/{childUid}/daily/{day} { allow write: if false; }

    // Лимит AI-запросов на пользователя (счётчик пишет только сервер через Admin SDK — клиент не может)
    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    match /duels/{duelId} {
      allow read: if isSignedIn() && isDuelPlayer(resource.data);
      allow write: if false;
    }
  }
}
