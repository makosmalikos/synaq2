{
  "name": "synaq",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "node --test tests/*.test.*",
    "test:rules": "firebase emulators:exec --only firestore --project demo-synaq-tests 'node --test tests/rules.test.mjs tests/duel-emulator.test.cjs'",
    "test:journey": "firebase emulators:exec --only auth,firestore --project demo-synaq-tests 'node --test tests/journey-emulator.test.cjs'",
    "dev:emulators": "firebase emulators:exec --only auth,firestore --project demo-synaq-tests 'node scripts/dev-emulators.mjs'",
    "check": "npm test && npm run validate:bank && npm run validate:curriculum && npm run build --prefix frontend && npm run validate:build",
    "validate:bank": "node scripts/validate-bank.mjs",
    "validate:curriculum": "node scripts/validate-curriculum.mjs",
    "validate:build": "node scripts/validate-build.mjs"
  },
  "engines": { "node": ">=22.12" },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.4.0"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "^11.1.1"
    },
    "firebase-tools": {
      "csv-parse": "^7.0.2",
      "@google-cloud/pubsub": {
        "@opentelemetry/core": "^2.8.0"
      }
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.30.2"
  }
}
